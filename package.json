{
  "name": "test",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon -r tsconfig-paths/register --exec ts-node ./src/server.ts --files",
    "start": "cross-env NODE_ENV=production node ./build/src/server.js",
    "build": "tsc && tsc-alias",
    "lint": "eslint ./src/**/*.ts --fix",
    "format": "prettier --write ./**/*.{ts,json}",
    "test": "jest --coverage=true -w=1 --forceExit --detectOpenHandles --watchAll=false --testPathPattern=src/__tests__ --testPathIgnorePatterns=build",
    "script:keys": "mkdir keys && openssl genpkey -algorithm RSA -out keys/private.pem -pkeyopt rsa_keygen_bits:2048",
    "script:adapt": "node ./scripts/adaptDocker.js",
    "script:postman": "node ./scripts/generatePostmanCollection.js",
    "script:db-types": "node ./scripts/generateDbTypes.js",
    "docker:services": "docker compose -f docker-compose.services.yml --env-file .env.docker up -d",
    "docker:dev": "docker compose -f docker-compose.api.yml --env-file .env.docker up",
    "docker:dev:nocache": "docker compose -f docker-compose.api.yml --env-file .env.docker build --no-cache && docker compose -f docker-compose.api.yml --env-file .env.docker up",
    "migrate": "node ./scripts/migrate.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16",
    "express": "^4",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "pg": "^8.14.1",
    "rate-limit-redis": "^5.0.0",
    "resend": "^4.3.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.62"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2",
    "@types/express": "^4",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^29",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.1.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "cross-env": "^7",
    "eslint": "^8",
    "eslint-config-prettier": "^9",
    "eslint-plugin-import": "^2",
    "eslint-plugin-jest": "^28.14.0",
    "eslint-plugin-n": "^16",
    "eslint-plugin-prettier": "^5",
    "eslint-plugin-promise": "^6",
    "jest": "^29",
    "nodemon": "^3",
    "prettier": "^3",
    "ts-jest": "^29",
    "ts-node": "^10",
    "tsc-alias": "^1",
    "tsconfig-paths": "^4",
    "typescript": "~5.3",
    "typescript-transform-paths": "^3.5.5"
  }
}
