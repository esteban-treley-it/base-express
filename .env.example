REACT_APP_URL=http://localhost:8080
NEXT_APP_URL=http://localhost:3000

JWT_SECRET_KEY_PATH=/keys/XXXXXXX

PORT=8000
NODE_ENV=local
# Reverse-proxy hops to trust for client IP (req.ip). Unset = 1 in production, 0 otherwise.
# Set to the real number of proxies in front of the app (Railway: verify). 0 if exposed directly.
TRUST_PROXY_HOPS=

POSTGRES_USER=XXXXXXX
POSTGRES_PASSWORD=XXXXXXX
POSTGRES_DB=XXXXXXX
POSTGRES_HOST=XXXXXXX
POSTGRES_PORT=XXXXXXX

REDIS_HOST=XXXXXXX
REDIS_PORT=XXXXXXX
REDIS_PASSWORD=XXXXXXX
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}
REDIS_URL_AUTH=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

BCRYPT_SALT_ROUNDS=10
RESEND_API_KEY=XXXXXXX
ONBOARDING_EMAIL=

# --- Feature modules ---
# Leave empty/unset to keep a module off (default). Set to "true" to enable.
# Alternatively, drop a modules.json (see modules.example.json) to override these
# without touching env vars - it takes precedence over the vars below.
MODULE_EMAIL_VERIFICATION=
MODULE_GOOGLE_AUTH=
MODULE_PASSWORD_CHANGE=
MODULE_REDIS_RATE_LIMIT=
MODULES_CONFIG_PATH=

# --- Logging ---
# Numeric level: error=0, warn=1, info=2, debug=3. Defaults to 2 in production, 3 otherwise.
LOG_LEVEL=

# --- Google Sign-In (requires MODULE_GOOGLE_AUTH=true) ---
# Same OAuth client ID used by the frontend; expected `aud` when verifying the ID token.
# Empty disables the /auth/google endpoint even if the module flag is on.
GOOGLE_CLIENT_ID=